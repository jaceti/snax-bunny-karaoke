{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snax-bunny-karaoke",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare account "Snax"
  "account_id": "b0f1589936f87faae686bf430775fa17",
  // Custom entry delegates web requests to vinext and handles the nightly reset.
  "main": "worker.ts",
  // 3 AM Pacific is 10 UTC in summer / 11 UTC in winter; the other run is a no-op.
  "triggers": { "crons": ["0 10,11 * * *"] },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snax-karaoke",
      "database_id": "198080d6-ea54-4ea4-97b6-cb9375064b98"
    }
  ]
}
